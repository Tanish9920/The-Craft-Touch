<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>The Craft Touch | Handmade Art Collection</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #f8f5f2;
            color: #333;
        }
        header {
            background: #b07a4a;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header h1 {
            color: #fff;
            margin: 0;
        }
        nav a {
            color: #fff;
            text-decoration: none;
            margin-left: 20px;
            font-weight: 500;
        }
        nav a:hover {
            text-decoration: underline;
        }
        .page-title {
            text-align: center;
            padding: 40px 20px;
        }
        .page-title h2 {
            font-size: 34px;
            margin-bottom: 10px;
        }
        .page-title p {
            font-size: 16px;
            color: #555;
        }
        .product-list {
            padding: 40px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 30px;
        }
        .item {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.1);
            padding: 15px;
            text-align: center;
        }
        .item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
        }
        .item h3 {
            margin: 12px 0 5px;
        }
        .item p {
            font-size: 14px;
            color: #666;
        }
        .item span {
            display: block;
            margin: 8px 0;
            font-weight: bold;
            color: #b07a4a;
        }
        .item button {
            padding: 10px 15px;
            background: #b07a4a;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .item button:hover {
            background: #94603a;
        }
        footer {
            background: #b07a4a;
            color: #fff;
            text-align: center;
            padding: 15px;
            margin-top: 30px;
        }
    </style>
</head>
<body>

<header>
    <h1>The Craft Touch</h1>
    <nav>
        <a href="home.html">Home</a>
        <a href="#">Shop</a>
        <a href="cart.html">Cart 🛒</a>
    </nav>
</header>

